# Только placeholders. Создать локальный .env: ./scripts/run.sh init (через Docker)
FSP_DB_PASSWORD=replace-with-random-local-password
FSP_RUNNER_TOKEN=replace-with-random-local-runner-token
FSP_DEMO_MODE=1
# Безопасные значения локального демонстрационного стенда.
FSP_DEMO_LOGIN=1
FSP_MOCK_MAIL=1
FSP_ALLOWED_HOSTS=
FSP_ALLOWED_ORIGINS=
FSP_COOKIE_SECURE=0
FSP_INTEGRITY_ENFORCE=1
FSP_CONFIRMATION_BAND=6
FSP_REGISTRY_UNAVAILABLE=0
# ИИ-помощник по умолчанию выключен. Ключ задаётся только в локальном .env.
FSP_LLM_PROVIDER=none
FSP_LLM_BASE_URL=
FSP_LLM_MODEL=
# FSP_LLM_API_KEY=replace-locally
FSP_LLM_TIMEOUT=8
# Генерация задания занимает 15–70 с; лимит применяется только к ней (не более 120)
FSP_LLM_GENERATION_TIMEOUT=100
# Внешняя почта выключена; FSP_SMTP_HOST без явного включения отклоняется.
FSP_SMTP_ENABLED=0
# SMTP только после проверки оператора, договора и размещения: docs/58.
# Переключатель включает транспорт, а не подтверждает соответствие закону.
# FSP_SMTP_ENABLED=1
# FSP_SMTP_HOST=mail.example.invalid
# FSP_SMTP_PORT=587
# FSP_SMTP_TLS=starttls
# FSP_SMTP_FROM=fsp@example.invalid
# FSP_SMTP_USER=replace-locally
# FSP_SMTP_PASSWORD=replace-locally
# Только для быстрых автоматических прогонов: предел попыток входа в минуту с одного адреса (не ниже 30)
# FSP_AUTH_RATE_LIMIT=30
